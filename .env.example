# Copy this file to .env and put your key after the "=". .env is git-ignored: never commit it.
# neai reads .env from the folder you run it in, then from the project root. Shell variables win.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_MAX_TOKENS=8000      # raise it if big apps come back cut off

# Where neai keeps all state (apps, code, data, logs). The default is the database that
# `docker compose up -d` starts from the repo root; in a cloud, point it at a managed Postgres.
# NEAI_DATABASE_URL=postgresql://neai:neai@127.0.0.1:5433/neai
