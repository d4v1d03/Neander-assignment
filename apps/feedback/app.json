{
  "name": "feedback",
  "description": "Shared feedback posts that anyone can read; logged-in users post and vote (one counted vote per user per post); moderators can delete posts.",
  "auth": {"signup": "open", "roles": ["moderator"]},
  "collections": {
    "posts": {
      "author": {"type": "string"},
      "text": {"type": "string"}
    },
    "votes": {
      "post_id": {"type": "integer"},
      "voter": {"type": "string"}
    }
  },
  "unique": {"votes": [["post_id", "voter"]]},
  "handlers": {
    "create_post": {"kind": "write", "args": {"text": {"type": "string"}}},
    "list_posts": {"kind": "read", "access": "public"},
    "vote": {"kind": "write", "args": {"post_id": {"type": "integer"}}},
    "delete_post": {"kind": "write", "access": "moderator", "args": {"post_id": {"type": "integer"}}}
  }
}
